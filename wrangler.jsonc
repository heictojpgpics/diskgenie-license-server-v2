// DiskGenie license server — Cloudflare Worker configuration (wrangler v4).
//
// Deploy guide + all secrets setup: README.md. The D1 binding below is the
// ONLY thing to edit per deployment (database_id). Secrets are set with
// `wrangler secret put` (never committed):
//   LICENSE_SIGNING_PRIVATE_KEY  — 64-hex Ed25519 seed (scripts/generate-keypair.mjs)
//   ADMIN_API_KEY                — admin API bearer (scripts/generate-secret.mjs)
//   CLIENT_REQUEST_SECRET        — 64-hex HMAC shared with the app client
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diskgenie-license",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [],
  // v2 fix: the deployment URL this whole system points at IS the
  // workers.dev subdomain (the app's LICENSE_API_BASE). v1 shipped
  // "false" here, so any redeploy silently DISABLED the hostname —
  // every request then 404s with Cloudflare "error code: 1042" (the
  // owner hit exactly this after the first redeploy). Keep true while
  // serving on workers.dev; switch to false only when you move to the
  // custom domain (routes below) in the SAME deploy.
  //
  // ⚠️ NAME-CUTOVER (DiskBytes → DiskGenie, 2026-10): the DEPLOYED
  // worker is still named "diskbytes-license" (still answering at
  // diskbytes-license.heictojpg-pics.workers.dev — the app points
  // there today). Deploying THIS config renames the worker, which
  // moves its URL to diskgenie-license.heictojpg-pics.workers.dev and
  // KILLS the old hostname. The zero-break cutover sequence:
  //   1. In the Cloudflare dashboard, attach custom domain
  //      license.diskgenie.app to the EXISTING diskbytes-license
  //      worker (the domain is already on the account) — it starts
  //      answering on BOTH hostnames.
  //   2. In the APP repo, flip LICENSE_API_BASE
  //      (src-tauri/src/license.rs) and the two E2E workflow URLs
  //      to https://license.diskgenie.app — ship that build.
  //   3. Then deploy this renamed config (the old hostname dies
  //      after every installed client has the new URL).
  "workers_dev": true,
  "routes": [
    // The stable product-domain URL (step 1 above, then uncomment for
    // step 3 so the worker serves on license.diskgenie.app):
    // { "pattern": "license.diskgenie.app", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    // Offline grace window baked into every issued token. Keep in sync with
    // the app's GRACE_DAYS (src-tauri/src/license.rs).
    "TOKEN_TTL_DAYS": "14",
    // Rate limiting (per-key activate attempts per hour; default 10).
    // Validate is 6x the activate limit; deactivate matches activate.
    // The per-IP activate limit (30/h) is code-level, not a var.
    "RATE_ACTIVATE_KEY_PER_HR": "10",
    // Admin API limits (bearer-key surface — consumed BEFORE the bearer
    // check, so even invalid keys burn the buckets; brute force cannot
    // probe ADMIN_API_KEY unlimited): per-route 120/h bounds any single
    // operation globally, per-IP 240/h bounds each source across ALL
    // admin routes.
    "RATE_ADMIN_PER_HR": "120",
    "RATE_ADMIN_IP_PER_HR": "240"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diskgenie-license",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
